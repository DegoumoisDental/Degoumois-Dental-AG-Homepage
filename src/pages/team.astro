---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";

const all = (await getCollection("team")).sort((a, b) => a.data.order - b.data.order);
const management = all.filter((m) => m.data.lead);
const staff = all.filter((m) => !m.data.lead);

const glRendered = await Promise.all(
  management.map(async (m) => {
    const { Content } = await m.render();
    return { data: m.data, Content, hasBio: m.body.trim().length > 0 };
  })
);
---

<BaseLayout
  title="Team"
  description="Das Team der Degoumois Dental AG – erfahrene Zahntechnikerinnen und Zahntechniker aus Solothurn, spezialisiert auf CAD/CAM, Keramik, Prothetik und Implantattechnik."
>
  <PageHeader
    eyebrow="Unser Team"
    title="Die Menschen hinter der Präzision"
    lead="Ein eingespieltes Team von Spezialistinnen und Spezialisten – flexibel, engagiert und mit Leidenschaft für hochwertige Zahntechnik."
    image="/img/labor/zahnarzt-fokus.jpg"
    imageAlt="Zahnarzt fokussiert bei der Arbeit"
  />

  <!-- Geschäftsleitung -->
  <section class="section">
    <div class="container">
      <div class="section-label" data-reveal>
        <p class="eyebrow">Geschäftsleitung</p>
      </div>
      <div class="gl-grid">
        {glRendered.map(({ data, Content, hasBio }, i) => (
          <article class="gl-card" data-reveal data-delay={i + 1}>
            <div class="card-photo">
              {data.photo
                ? <img src={data.photo} alt={data.name} loading="lazy" style={`--photo-zoom: ${data.photoZoom ?? 1}`} />
                : <div class="photo-fallback"><Icon name="user" class="fallback-icon" /></div>}
            </div>
            <div class="gl-glass">
              <p class="card-role">{data.role}</p>
              <h3 class="card-name">{data.name}</h3>
              {data.email && (
                <a href={`mailto:${data.email}`} class="card-email">
                  <Icon name="mail" /> {data.email}
                </a>
              )}
              {hasBio && (
                <Fragment>
                  <div class="card-bio">
                    <Content />
                    {data.vitae && data.vitae.length > 0 && (
                      <ul class="vitae-timeline">
                        {data.vitae.map((item) => <li>{item}</li>)}
                      </ul>
                    )}
                    {data.quote && (
                      <blockquote class="card-quote">
                        „{data.quote}“
                        {data.quoteAuthor && <cite>{data.quoteAuthor}</cite>}
                      </blockquote>
                    )}
                  </div>
                  <button class="mehr-btn" aria-expanded="false">
                    Mehr lesen
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                  </button>
                </Fragment>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Mitarbeiter -->
  <section class="section staff-section">
    <div class="container">
      <div class="section-label" data-reveal>
        <p class="eyebrow">Mitarbeiterinnen & Mitarbeiter</p>
      </div>
      <div class="staff-grid">
        {staff.map((m, i) => (
          <article class="staff-card" data-reveal data-delay={(i % 5) + 1}>
            <div class="card-photo">
              {m.data.photo
                ? <img src={m.data.photo} alt={m.data.name} loading="lazy" style={`--photo-zoom: ${m.data.photoZoom ?? 1}`} />
                : <div class="photo-fallback"><Icon name="user" class="fallback-icon" /></div>}
            </div>
            <div class="staff-glass">
              <p class="card-name-sm">{m.data.name}</p>
              <p class="card-role-sm">{m.data.role}</p>
              {m.data.email && (
                <a href={`mailto:${m.data.email}`} class="card-email-sm" aria-label={m.data.email} title={m.data.email}>
                  <Icon name="mail" />
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-label { margin-bottom: 2.5rem; }

  /* ── Geschäftsleitung ─────────────────────────────── */
  .gl-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 420px));
    justify-content: center;
    gap: 2rem;
  }

  .gl-card {
    position: relative;
    border-radius: 1.25rem;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    box-shadow: 0 20px 60px rgba(8, 41, 61, 0.22);
    background: var(--brand-950);
  }

  /* Photo fills full card */
  .gl-card .card-photo {
    position: absolute;
    inset: 0;
  }

  .gl-card .card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transform-origin: center top;
    transform: scale(var(--photo-zoom, 1));
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .gl-card:hover .card-photo img { transform: scale(calc(var(--photo-zoom, 1) * 1.04)); }


  /* Liquid glass panel – bottom only */
  .gl-glass {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    background: rgba(8, 41, 61, 0.68);
    backdrop-filter: blur(32px) saturate(160%);
    -webkit-backdrop-filter: blur(32px) saturate(160%);
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 0 0 1.2rem 1.2rem;
    padding: 1rem 1.4rem 1.25rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15);
  }

  .card-role {
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(180, 220, 245, 0.95);
    margin-bottom: 0.25rem;
    line-height: 1.35;
  }

  .card-name {
    font-size: 1.3rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 0;
    letter-spacing: -0.01em;
  }

  .card-email {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.35rem;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    transition: color 0.2s;
  }
  .card-email:hover { color: #fff; }

  /* Bio: hidden by default, revealed on toggle */
  .card-bio {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.35s ease,
                margin-top 0.3s ease;
    opacity: 0;
    margin-top: 0;
    font-size: 0.82rem;
    line-height: 1.62;
    color: #fff;
  }

  .card-bio.is-open {
    max-height: 420px;
    opacity: 1;
    margin-top: 0.65rem;
  }

  .card-bio :global(p) { margin: 0; color: #fff; }

  /* Simple downward timeline for Vitae-Stichpunkte */
  .vitae-timeline {
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
  }

  .vitae-timeline li {
    position: relative;
    padding-left: 1.05rem;
    padding-bottom: 0.55rem;
    font-size: 0.78rem;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.9);
  }

  .vitae-timeline li:last-child { padding-bottom: 0; }

  .vitae-timeline li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.35em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(180, 220, 245, 0.95);
  }

  .vitae-timeline li::after {
    content: "";
    position: absolute;
    left: 2.5px;
    top: 0.85em;
    bottom: -0.1em;
    width: 1px;
    background: rgba(255, 255, 255, 0.25);
  }

  .vitae-timeline li:last-child::after { display: none; }

  .card-quote {
    margin: 0.85rem 0 0;
    padding-top: 0.65rem;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    font-size: 0.76rem;
    font-style: italic;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
  }

  .card-quote cite {
    display: block;
    margin-top: 0.3rem;
    font-style: normal;
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(180, 220, 245, 0.9);
  }

  .mehr-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.55rem;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.78rem;
    color: rgba(180, 220, 245, 0.9);
    letter-spacing: 0.02em;
    transition: color 0.2s;
  }

  .mehr-btn:hover { color: #fff; }

  .mehr-btn svg {
    width: 14px;
    height: 14px;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mehr-btn.is-open svg { transform: rotate(180deg); }

  /* ── Mitarbeiter ──────────────────────────────────── */
  .staff-section {
    background: var(--surface-2);
    border-top: 1px solid var(--line);
  }

  .staff-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
  }

  .staff-card {
    position: relative;
    border-radius: 0.875rem;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: var(--brand-900);
    box-shadow: 0 4px 20px rgba(8, 41, 61, 0.14);
  }

  .staff-card .card-photo {
    position: absolute;
    inset: 0;
  }

  .staff-card .card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transform-origin: center top;
    transform: scale(var(--photo-zoom, 1));
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .staff-card:hover .card-photo img { transform: scale(calc(var(--photo-zoom, 1) * 1.06)); }


  /* Liquid glass panel – staff */
  .staff-glass {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    background: rgba(8, 41, 61, 0.62);
    backdrop-filter: blur(22px) saturate(180%);
    -webkit-backdrop-filter: blur(22px) saturate(180%);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.75rem 0.875rem 0.875rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .card-name-sm {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    color: #fff;
    margin-bottom: 0.2rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-role-sm {
    font-size: 0.7rem;
    color: rgba(180, 215, 240, 0.85);
    line-height: 1.35;
  }

  .card-email-sm {
    display: inline-flex;
    align-items: center;
    margin-top: 0.35rem;
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.2s;
  }
  .card-email-sm:hover { color: #fff; }

  /* Fallback: Platzhalter für fehlendes Foto */
  .photo-bg {
    width: 100%;
    height: 100%;
    background-repeat: no-repeat;
    background-position: center top;
  }

  .photo-fallback {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: #e4e7ea;
  }

  .fallback-icon {
    width: 40%;
    height: 40%;
    color: #b7bec4;
    stroke-width: 1.3;
  }

  /* ── Responsive ───────────────────────────────────── */
  @media (max-width: 1100px) {
    .staff-grid { grid-template-columns: repeat(4, 1fr); }
  }

  @media (max-width: 900px) {
    .gl-grid { grid-template-columns: repeat(2, 1fr); }
    .staff-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 560px) {
    .gl-grid { grid-template-columns: 1fr; max-width: 320px; margin-inline: auto; }
    .staff-grid { grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
    .card-name { font-size: 1.15rem; }
  }
</style>

<script>
  function initMehrBtn() {
    document.querySelectorAll<HTMLButtonElement>(".mehr-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const bio = btn.previousElementSibling as HTMLElement;
        const open = bio.classList.toggle("is-open");
        btn.classList.toggle("is-open", open);
        btn.setAttribute("aria-expanded", String(open));
        btn.childNodes[0].textContent = open ? "Weniger " : "Mehr lesen ";
      });
    });
  }
  initMehrBtn();
  document.addEventListener("astro:after-swap", initMehrBtn);
</script>
