---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";

const all = (await getCollection("team")).sort((a, b) => a.data.order - b.data.order);
const management = all.filter((m) => m.data.lead);
const staff = all.filter((m) => !m.data.lead);

const glRendered = await Promise.all(
  management.map(async (m) => {
    const { Content } = await m.render();
    return { data: m.data, Content, hasBio: m.body.trim().length > 0 };
  })
);

/** Foto-Ausrichtung: photoZoom (0–100) = vertikaler Ausschnitt, photoScale = Zoom */
function photoStyle(photoZoom?: number, photoScale?: number) {
  const parts: string[] = [];
  if (photoZoom != null) parts.push(`object-position: center ${photoZoom}%`);
  if (photoScale != null) parts.push(`--photo-scale: ${photoScale}`);
  return parts.length ? parts.join("; ") : undefined;
}
---

<BaseLayout
  metaTitle="Team – Dentallabor Solothurn | Degoumois Dental"
  description="Das Team der Degoumois Dental AG – erfahrene Zahntechnikerinnen und Zahntechniker aus Solothurn, spezialisiert auf CAD/CAM, Keramik, Prothetik und Implantattechnik."
>
  <PageHeader
    eyebrow="Unser Team"
    title="Die Menschen hinter Ihrem Lächeln"
    lead="Ein eingespieltes Team von Spezialistinnen und Spezialisten – flexibel, engagiert und mit Leidenschaft für hochwertige Zahntechnik."
    image="/img/labor/zahnarzt-fokus.jpg"
    imageAlt="Zahnarzt fokussiert bei der Arbeit"
  />

  <!-- Geschäftsleitung -->
  <section class="section">
    <div class="container">
      <div class="section-label" data-reveal>
        <p class="eyebrow">Geschäftsleitung</p>
      </div>
      <div class="tgrid tgrid-gl">
        {glRendered.map(({ data, Content, hasBio }, i) => {
          return (
            <article class="tcard tcard-lead" data-reveal data-delay={i + 1}>
              <div class="tcard-photo">
                {data.photo
                  ? <img src={data.photo} alt={data.name} style={photoStyle(data.photoZoom, data.photoScale)} loading="lazy" />
                  : <div class="photo-fallback"><Icon name="user" class="fallback-icon" /></div>}
              </div>
              <div class="tcard-info">
                <h3 class="tcard-name">{data.name}</h3>
                <p class="tcard-desc">{data.role}</p>
                {data.email && (
                  <a href={`mailto:${data.email}`} class="tcard-email">
                    <Icon name="mail" /> {data.email}
                  </a>
                )}
                {hasBio && (
                  <Fragment>
                    <div class="tcard-bio">
                      <Content />
                      {data.vitae && data.vitae.length > 0 && (
                        <ul class="vitae-timeline">
                          {data.vitae.map((item) => <li>{item}</li>)}
                        </ul>
                      )}
                      {data.quote && (
                        <blockquote class="card-quote">
                          „{data.quote}“
                          {data.quoteAuthor && <cite>{data.quoteAuthor}</cite>}
                        </blockquote>
                      )}
                    </div>
                    <button class="mehr-btn" aria-expanded="false">
                      Mehr lesen
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                  </Fragment>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Mitarbeiter -->
  <section class="section staff-section">
    <div class="container">
      <div class="section-label" data-reveal>
        <p class="eyebrow">Mitarbeiterinnen & Mitarbeiter</p>
      </div>
      <div class="tgrid tgrid-staff">
        {staff.map((m, i) => {
          return (
            <article class="tcard" data-reveal data-delay={(i % 5) + 1}>
              <div class="tcard-photo">
                {m.data.photo
                  ? <img src={m.data.photo} alt={m.data.name} style={photoStyle(m.data.photoZoom, m.data.photoScale)} loading="lazy" />
                  : <div class="photo-fallback"><Icon name="user" class="fallback-icon" /></div>}
              </div>
              <div class="tcard-info">
                <h3 class="tcard-name">{m.data.name}</h3>
                <p class="tcard-desc">{m.data.role}</p>
                {m.data.email && (
                  <a href={`mailto:${m.data.email}`} class="tcard-email" title={m.data.email}>
                    <Icon name="mail" /> E-Mail
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-label { margin-bottom: 2.5rem; }

  /* ── Grid ─────────────────────────────────────────── */
  .tgrid { display: grid; gap: 1.5rem; }
  .tgrid-gl { grid-template-columns: repeat(3, 1fr); }
  .tgrid-staff { grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }

  /* ── Card (Screenshot-1-Stil) ─────────────────────── */
  .tcard {
    display: flex;
    flex-direction: column;
    border-radius: 1.25rem;
    overflow: hidden;
    background: linear-gradient(165deg, var(--brand-700), var(--brand-900));
    box-shadow: 0 14px 40px rgba(8, 41, 61, 0.18);
    transition: transform 0.45s var(--ease), box-shadow 0.45s var(--ease);
  }
  .tcard:hover { transform: translateY(-5px); box-shadow: 0 26px 60px rgba(8, 41, 61, 0.28); }

  /* Foto oben, Badge oben-links */
  .tcard-photo {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--brand-950);
  }
  .tcard-photo img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(1);
    transform: scale(var(--photo-scale, 1));
    transform-origin: center top;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94), filter 0.5s var(--ease);
  }
  .tcard:hover .tcard-photo img { transform: scale(calc(var(--photo-scale, 1) * 1.05)); filter: grayscale(0); }
  @media (prefers-reduced-motion: reduce) {
    .tcard-photo img { transition: none; }
  }


  /* Info-Footer (solides Blau) */
  .tcard-info {
    padding: 1.1rem 1.25rem 1.35rem;
    color: #fff;
  }
  .tcard-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
    color: #fff;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .tcard-desc {
    margin-top: 0.35rem;
    font-size: 0.85rem;
    line-height: 1.45;
    color: rgba(190, 224, 246, 0.92);
  }
  .tcard-email {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.6rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    transition: color 0.2s;
  }
  .tcard-email:hover { color: #fff; }
  .tcard-email :global(svg) { width: 14px; height: 14px; }

  /* Geschäftsleitung: grössere Karten + Bio */
  .tcard-lead .tcard-name { font-size: 1.4rem; }
  .tcard-lead .tcard-photo { aspect-ratio: 3 / 4; }

  /* Bio: standardmässig eingeklappt */
  .tcard-bio {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    margin-top: 0;
    font-size: 0.85rem;
    line-height: 1.62;
    color: rgba(255, 255, 255, 0.92);
    transition: max-height 0.45s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.35s ease, margin-top 0.3s ease;
  }
  .tcard-bio.is-open { max-height: 520px; opacity: 1; margin-top: 0.75rem; }
  .tcard-bio :global(p) { margin: 0 0 0.6rem; color: rgba(255, 255, 255, 0.92); }

  .vitae-timeline { list-style: none; margin: 0.85rem 0 0; padding: 0; }
  .vitae-timeline li {
    position: relative; padding-left: 1.05rem; padding-bottom: 0.55rem;
    font-size: 0.8rem; line-height: 1.4; color: rgba(255, 255, 255, 0.9);
  }
  .vitae-timeline li:last-child { padding-bottom: 0; }
  .vitae-timeline li::before {
    content: ""; position: absolute; left: 0; top: 0.35em;
    width: 6px; height: 6px; border-radius: 50%; background: rgba(180, 220, 245, 0.95);
  }
  .vitae-timeline li::after {
    content: ""; position: absolute; left: 2.5px; top: 0.85em; bottom: -0.1em;
    width: 1px; background: rgba(255, 255, 255, 0.25);
  }
  .vitae-timeline li:last-child::after { display: none; }

  .card-quote {
    margin: 0.85rem 0 0; padding-top: 0.65rem;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    font-size: 0.8rem; font-style: italic; line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
  }
  .card-quote cite {
    display: block; margin-top: 0.3rem; font-style: normal;
    font-size: 0.72rem; font-weight: 600; color: rgba(180, 220, 245, 0.9);
  }

  .mehr-btn {
    display: inline-flex; align-items: center; gap: 0.3rem; margin-top: 0.75rem;
    background: none; border: none; padding: 0; cursor: pointer;
    font-family: var(--font-display); font-weight: 600; font-size: 0.8rem;
    color: rgba(180, 220, 245, 0.95); letter-spacing: 0.02em; transition: color 0.2s;
  }
  .mehr-btn:hover { color: #fff; }
  .mehr-btn svg { width: 14px; height: 14px; transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1); }
  .mehr-btn.is-open svg { transform: rotate(180deg); }

  /* Fallback für fehlendes Foto */
  .photo-fallback { width: 100%; height: 100%; display: grid; place-items: center; background: #e4e7ea; }
  .fallback-icon { width: 34%; height: 34%; color: #b7bec4; stroke-width: 1.3; }

  .staff-section { background: var(--surface-2); border-top: 1px solid var(--line); }

  /* ── Responsive ───────────────────────────────────── */
  @media (max-width: 1100px) {
    .tgrid-gl { grid-template-columns: repeat(3, 1fr); }
    .tgrid-staff { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 820px) {
    .tgrid-gl { grid-template-columns: repeat(2, 1fr); }
    .tgrid-staff { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .tgrid-gl { grid-template-columns: 1fr; max-width: 340px; margin-inline: auto; }
    .tgrid-staff { grid-template-columns: repeat(2, 1fr); gap: 0.85rem; }
    .tcard-name { font-size: 1.05rem; }
    .tcard-lead .tcard-name { font-size: 1.25rem; }
  }
</style>

<script>
  function initMehrBtn() {
    document.querySelectorAll<HTMLButtonElement>(".mehr-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const bio = btn.previousElementSibling as HTMLElement;
        const open = bio.classList.toggle("is-open");
        btn.classList.toggle("is-open", open);
        btn.setAttribute("aria-expanded", String(open));
        btn.childNodes[0].textContent = open ? "Weniger " : "Mehr lesen ";
      });
    });
  }
  initMehrBtn();
  document.addEventListener("astro:after-swap", initMehrBtn);
</script>
