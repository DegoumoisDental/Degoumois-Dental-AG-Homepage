---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";

const timeline = [
  {
    year: "1972",
    title: "Gründung durch Georges Degoumois",
    text: "Mit der Gründung des Dentallabors in Solothurn legt Georges Degoumois den Grundstein für ein Unternehmen, das zahntechnisches Handwerk, Qualität und persönliche Zusammenarbeit miteinander verbindet.",
  },
  {
    year: "2013",
    title: "Übernahme durch Martin Svarovsky",
    text: "Martin Svarovsky übernimmt die Degoumois Dental AG und führt die gewachsenen Werte des Unternehmens weiter. Gleichzeitig wird die Digitalisierung des Labors konsequent vorangetrieben.",
  },
  {
    year: "Heute",
    title: "Modernes digitales Dentallabor",
    text: "Heute verbindet Degoumois Dental traditionelle zahntechnische Kompetenz mit CAD/CAM-Technologie, 3D-Druck, digitalen Workflows und moderner Implantatplanung. Die Fertigung erfolgt weiterhin in Solothurn – persönlich, präzise und mit kurzen Entscheidungswegen.",
  },
];

const values = [
  { title: "Qualität", text: "Jede Arbeit wird individuell geplant und präzise umgesetzt. Unser Anspruch ist Zahnersatz, der funktional, ästhetisch und technisch überzeugt." },
  { title: "Kompetenz", text: "Mehr als 50 Jahre Erfahrung treffen bei uns auf kontinuierliche Weiterbildung und moderne zahntechnische Technologien." },
  { title: "Partnerschaft", text: "Eine enge Zusammenarbeit zwischen Zahnarztpraxis und Dentallabor ermöglicht bessere Abläufe und individuell abgestimmte Lösungen." },
  { title: "Innovation", text: "CAD/CAM, 3D-Druck, digitale Datenverarbeitung und moderne Implantatplanung gehören heute selbstverständlich zu unserem Laboralltag." },
  { title: "Service", text: "Von der Fallbesprechung bis zum eigenen Kurierdienst unterstützen wir unsere Partnerpraxen auch über die eigentliche Fertigung hinaus." },
];
---

<BaseLayout
  metaTitle="Dentallabor Solothurn seit 1972 | Degoumois Dental"
  description="Degoumois Dental AG steht seit 1972 für präzise Zahntechnik aus Solothurn. Lernen Sie unsere Philosophie, Geschichte und Verbindung aus Handwerk und Digitalisierung kennen."
>
  <PageHeader
    eyebrow="Über uns"
    title="Dentallabor in Solothurn seit 1972"
    lead="Traditionelle Zahntechnik und digitale Präzision sind für uns keine Gegensätze."
    image="/img/labor/eingang-logo.jpg"
    imageAlt="Eingang der Degoumois Dental AG in Solothurn"
  />

  <!-- Philosophie -->
  <section class="section">
    <div class="container phil-grid">
      <div data-reveal>
        <p class="eyebrow">Philosophie & Anspruch</p>
        <h2>Zahnersatz ist für uns ein individuelles Werkstück</h2>
        <div class="phil-img" data-reveal data-delay="1">
          <img src="/img/labor/korridor-team.jpg" alt="Team der Degoumois Dental AG im Dentallabor in Solothurn" loading="lazy" decoding="async" />
        </div>
      </div>
      <div data-reveal data-delay="2">
        <p class="lead">
          Zahnersatz mit einem Schmuckstück zu vergleichen, beschreibt unsere Philosophie sehr
          treffend. Beides entsteht durch Präzision, Erfahrung, hochwertige Materialien und
          Liebe zum Detail.
        </p>
        <p>
          Deshalb betrachten wir jede zahntechnische Arbeit als individuelle Anfertigung.
          Funktion, Passung und natürliche Ästhetik müssen dabei ebenso überzeugen wie die
          technische Umsetzung.
        </p>
        <p>
          Unsere Zahntechnikerinnen und Zahntechniker verbinden handwerkliche Erfahrung mit
          modernen digitalen Verfahren und entwickeln ihr Fachwissen kontinuierlich weiter.
        </p>
        <p>
          Genauso wichtig ist für uns die Zusammenarbeit mit der Zahnarztpraxis. Technische
          Anforderungen, individuelle Vorstellungen und die Bedürfnisse der Patientinnen und
          Patienten sollen von Anfang an verstanden werden.
        </p>
        <p>
          Denn hochwertige Zahntechnik entsteht dort, wo Fachkompetenz, Kommunikation und
          gegenseitiges Vertrauen zusammenkommen.
        </p>
      </div>
    </div>
  </section>

  <!-- Werte -->
  <section class="section" style="background:var(--surface-2);border-block:1px solid var(--line);">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Werte</p>
        <h2>Präzision. Vertrauen. Zusammenarbeit.</h2>
      </div>
      <div class="values-text" data-reveal data-delay="1">
        <p class="lead">
          Vertrauen in unsere Kompetenz ist die Grundlage unserer täglichen Arbeit. Wir
          verwenden ausgewählte Werkstoffe, die hohen zahnmedizinischen Standards entsprechen,
          und fertigen jeden Auftrag mit grosser Sorgfalt.
        </p>
        <p>
          Dabei geht Qualität für uns weit über die eigentliche zahntechnische Arbeit hinaus.
          Zahnarztpraxen sollen bei Degoumois Dental jederzeit wissen, welche technischen
          Möglichkeiten bestehen, welche Materialien eingesetzt werden können und welche
          Varianten für einen Fall infrage kommen. Deshalb legen wir grossen Wert auf
          transparente Kommunikation, kompetente technische Beratung und persönliche
          Ansprechpartner.
        </p>
      </div>
      <div class="value-grid">
        {values.map((v, i) => (
          <div class="value-item card" data-reveal data-delay={(i % 3) + 1}>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Geschichte -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Unsere Geschichte</p>
        <h2>Mehr als 50 Jahre Zahntechnik aus Solothurn</h2>
      </div>
      <ol class="timeline">
        {timeline.map((t, i) => (
          <li class="tl-item" data-reveal data-delay={(i % 3) + 1}>
            <span class="tl-year">{t.year}</span>
            <div class="tl-card card">
              <h3>{t.title}</h3>
              <p>{t.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Tradition & Vision -->
  <section class="section quote-band">
    <div class="qb-photo" aria-hidden="true">
      <img src="/img/labor/korridor-kunst.jpg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="container text-center" data-reveal style="position:relative;z-index:1;">
      <p class="eyebrow qb-eyebrow">Tradition & Vision</p>
      <blockquote>„Die Geschichte der Menschheit ist die Geschichte der menschlichen Visionen."</blockquote>
      <p class="qb-cite">Hans Kasper</p>
      <p class="qb-text">
        Tradition und Innovation schliessen sich für uns nicht aus. Im Gegenteil:
        Jahrzehntelange Erfahrung bildet die Grundlage dafür, neue Technologien sinnvoll
        einzusetzen. Wir bewahren das zahntechnische Wissen und die handwerkliche Präzision,
        die unser Labor seit 1972 prägen, und verbinden sie mit den Möglichkeiten der digitalen
        Zahntechnik.
      </p>
      <p class="qb-text">
        So entwickeln wir unsere Arbeit kontinuierlich weiter – ohne den Blick für das
        Wesentliche zu verlieren: individuelle zahntechnische Lösungen und eine verlässliche
        Zusammenarbeit mit unseren Partnerpraxen.
      </p>
      <a href="/team" class="btn btn-light" style="margin-top:2rem;">Unser Team kennenlernen <Icon name="arrow" /></a>
    </div>
  </section>
</BaseLayout>

<style>
  .phil-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .section-head { display: flex; flex-direction: column; align-items: center; gap: 0.8rem; text-align: center; margin-bottom: 3rem; }

  .values-text { max-width: 68ch; margin-inline: auto; display: flex; flex-direction: column; gap: 1.25rem; }
  .values-text p { color: var(--ink-500); }
  .values-text .lead { color: var(--ink-900); }

  .value-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-top: 3rem; }
  .value-item { padding: 1.75rem; }
  .value-item h3 { font-size: 1.15rem; margin-bottom: 0.5rem; color: var(--accent-deep); }
  .value-item p { color: var(--ink-500); font-size: 0.96rem; }

  .timeline { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; counter-reset: tl; }
  .tl-item { position: relative; display: flex; flex-direction: column; gap: 1rem; }
  .tl-year { font-family: var(--font-display); font-weight: 800; font-size: 1.6rem; color: var(--brand-500); }
  .tl-card { padding: 1.75rem; flex: 1; }
  .tl-card h3 { margin-bottom: 0.5rem; font-size: 1.2rem; }
  .tl-card p { color: var(--ink-500); }

  .quote-band {
    position: relative; overflow: hidden;
    background: var(--brand-950);
    color: #fff;
  }
  .qb-photo { position: absolute; inset: 0; z-index: 0; }
  .qb-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; opacity: 0.22; mix-blend-mode: luminosity; }

  .phil-img { margin-top: 2rem; border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4/3; }
  .phil-img img { width: 100%; height: 100%; object-fit: cover; }
  blockquote { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.4rem, 3vw, 2.1rem); line-height: 1.3; color: #fff; max-width: 28ch; margin-inline: auto; letter-spacing: -0.01em; }
  .qb-eyebrow { justify-content: center; color: #fff; opacity: 0.85; margin-bottom: 1.25rem; }
  .qb-eyebrow::before { background: rgba(255, 255, 255, 0.6); }
  .qb-cite { margin-top: 1rem; font-family: var(--font-display); font-weight: 600; letter-spacing: 0.02em; color: rgba(255, 255, 255, 0.7); }
  .qb-text { max-width: 56ch; margin: 1.75rem auto 0; color: rgba(255, 255, 255, 0.85); }

  @media (max-width: 900px) {
    .phil-grid { grid-template-columns: 1fr; }
    .value-grid { grid-template-columns: 1fr; }
    .timeline { grid-template-columns: 1fr; }
  }
</style>
