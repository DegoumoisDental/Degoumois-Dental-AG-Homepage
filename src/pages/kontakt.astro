---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";
import { site } from "../site";
const tel = site.phone.replace(/\s/g, "");
const mapsQuery = encodeURIComponent(`${site.legalName}, ${site.address.street}, ${site.address.zip} ${site.address.city}`);
---

<BaseLayout
  metaTitle="Kontakt & Anfahrt – Dentallabor Solothurn | Degoumois Dental"
  description="Kontaktieren Sie die Degoumois Dental AG in Solothurn – direkt gegenüber dem Westbahnhof. Telefon, E-Mail, Adresse und Anreise mit dem Zug."
>
  <PageHeader
    eyebrow="Kontakt"
    title="So erreichen Sie uns"
    lead="Wir freuen uns auf Ihren Auftrag, Ihre Fragen und ein persönliches Kennenlernen – direkt gegenüber dem Bahnhof Solothurn Westbahnhof."
    image="/img/labor/degoumois_haus_aussen.jpg"
    imageAlt="Gebäude der Degoumois Dental AG in Solothurn"
  />

  <section class="section">
    <div class="container contact-grid">
      <!-- Kontaktinfos -->
      <div class="contact-info" data-reveal>
        <ul class="info-list">
          <li>
            <span class="info-icon"><Icon name="pin" /></span>
            <div>
              <h3>Adresse</h3>
              <p>{site.legalName}<br />{site.address.street}<br />{site.address.zip} {site.address.city}</p>
            </div>
          </li>
          <li>
            <span class="info-icon"><Icon name="phone" /></span>
            <div>
              <h3>Telefon</h3>
              <p><a href={`tel:${tel}`}>{site.phoneDisplay}</a></p>
            </div>
          </li>
          <li>
            <span class="info-icon"><Icon name="mail" /></span>
            <div>
              <h3>E-Mail</h3>
              <p>
                <a href={`mailto:${site.email}`}>{site.email}</a><br />
                <a href={`mailto:${site.emailHin}`}>{site.emailHin}</a> <span class="muted">(HIN)</span>
              </p>
            </div>
          </li>
          <li>
            <span class="info-icon"><Icon name="clock" /></span>
            <div>
              <h3>Öffnungszeiten</h3>
              {site.openingHours.map((o) => <p>{o.days}: {o.hours}</p>)}
            </div>
          </li>
        </ul>

        <div class="anreise card">
          <h3>Anreise mit dem Zug</h3>
          <p>Bis <strong>Solothurn Westbahnhof</strong>. Unser Labor befindet sich direkt gegenüber dem Bahnhof – ideal mit dem öffentlichen Verkehr erreichbar.</p>
        </div>

        <div class="contact-actions">
          <a href={`tel:${tel}`} class="btn btn-primary"><Icon name="phone" /> Jetzt anrufen</a>
          <a href={`mailto:${site.email}`} class="btn btn-ghost"><Icon name="mail" /> E-Mail schreiben</a>
        </div>
      </div>

      <!-- Karte (DSGVO-freundlich: erst nach Klick wird Google Maps geladen) -->
      <div class="contact-map" data-reveal data-delay="1">
        <div class="map-consent" id="map-consent" data-maps-src={`https://www.google.com/maps?q=${mapsQuery}&output=embed`}>
          <Icon name="pin" class="map-consent-icon" />
          <p class="map-consent-title">Standort auf Google Maps</p>
          <p class="map-consent-text">
            Beim Laden der Karte werden Daten an Google übertragen. Es gelten die
            <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Datenschutzbestimmungen von Google</a>.
          </p>
          <button type="button" class="btn btn-primary map-consent-btn" id="map-consent-btn">
            Karte laden
          </button>
          <a
            class="map-consent-link"
            href={`https://www.google.com/maps/search/?api=1&query=${mapsQuery}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Stattdessen in Google Maps öffnen
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Karriere / Offene Stellen -->
  <section class="section careers">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow mx-auto" style="justify-content:center;">Karriere</p>
        <h2 class="text-center">Werde Teil unseres Teams</h2>
      </div>
      <div class="careers-grid">
        <article class="career-card card" data-reveal>
          <span class="career-tag career-tag-open">Offene Stelle</span>
          <h3>Lehrstelle Zahntechniker:in EFZ</h3>
          <p class="career-meta">Start Sommer 2027 · Solothurn</p>
          <p>Du interessierst dich für Zahntechnik, digitales Arbeiten und präzises Handwerk?
          Wir bilden aus – in einem erfahrenen Team mit modernen Technologien und
          abwechslungsreichen zahntechnischen Fällen.</p>
          <a
            href={`mailto:s.kalimeri@degoumoisdental.ch?subject=${encodeURIComponent("Bewerbung Lehrstelle Zahntechniker:in EFZ 2027")}`}
            class="btn btn-primary"
          >
            <Icon name="mail" /> Jetzt bewerben
          </a>
        </article>

        <article class="career-card card" data-reveal data-delay="1">
          <span class="career-tag">Spontanbewerbung</span>
          <h3>Initiativ bewerben</h3>
          <p>Aktuell keine passende Stelle dabei? Wir freuen uns trotzdem über deine Bewerbung.
          Sende uns deinen Lebenslauf sowie – falls vorhanden – Zeugnisse, absolvierte Kurse
          und Weiterbildungen.</p>
          <a
            href={`mailto:s.kalimeri@degoumoisdental.ch?subject=${encodeURIComponent("Spontanbewerbung Degoumois Dental")}`}
            class="btn btn-ghost"
          >
            <Icon name="mail" /> Bewerbung senden
          </a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 4vw, 3.5rem); align-items: start; }
  .info-list { display: flex; flex-direction: column; gap: 1.75rem; }
  .info-list li { display: flex; gap: 1.1rem; }
  .info-icon { flex-shrink: 0; width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center; color: var(--brand-600); background: linear-gradient(135deg, var(--brand-50), var(--brand-100)); font-size: 24px; }
  .info-list h3 { font-size: 1.1rem; margin-bottom: 0.25rem; }
  .info-list a { color: var(--brand-600); font-weight: 600; }
  .info-list a:hover { color: var(--brand-700); }
  .muted { color: var(--ink-400); font-weight: 400; font-size: 0.9rem; }
  .anreise { padding: 1.75rem; margin-top: 2rem; background: var(--surface-2); }
  .anreise h3 { margin-bottom: 0.5rem; }
  .anreise p { color: var(--ink-700); }
  .contact-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2rem; }

  .contact-map { position: sticky; top: calc(var(--header-h) + 1.5rem); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md); border: 1px solid var(--line); aspect-ratio: 4/5; min-height: 480px; }
  .contact-map iframe { border: 0; display: block; height: 100%; width: 100%; }
  .map-consent {
    height: 100%; width: 100%;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 0.6rem; padding: 2rem; text-align: center;
    background: var(--surface-2);
    background-image: linear-gradient(rgba(8,41,61,0.72), rgba(8,41,61,0.72)), url("/img/labor/degoumois_haus_aussen.jpg");
    background-size: cover; background-position: center;
    color: #fff;
  }
  .map-consent :global(.map-consent-icon) { width: 40px; height: 40px; color: #a8dbf1; margin-bottom: 0.25rem; }
  .map-consent-title { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; color: #fff; }
  .map-consent-text { font-size: 0.9rem; color: rgba(255,255,255,0.85); max-width: 34ch; }
  .map-consent-text a { color: #a8dbf1; text-decoration: underline; }
  .map-consent-btn { margin-top: 0.5rem; }
  .map-consent-link { margin-top: 0.35rem; font-size: 0.85rem; color: rgba(255,255,255,0.8); text-decoration: underline; }
  .map-consent-link:hover { color: #fff; }

  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-map { position: static; aspect-ratio: 16/10; min-height: 340px; }
  }

  /* Karriere */
  .careers { background: var(--surface-2); border-top: 1px solid var(--line); }
  .section-head { display: flex; flex-direction: column; align-items: center; gap: 0.8rem; margin-bottom: 3rem; }
  .careers-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; max-width: 960px; margin-inline: auto; }
  .career-card { display: flex; flex-direction: column; align-items: flex-start; gap: 0.6rem; padding: 2rem; }
  .career-tag {
    display: inline-block; font-family: var(--font-display); font-weight: 600;
    font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 0.35em 0.8em; border-radius: 999px;
    background: var(--surface-3); color: var(--ink-500);
  }
  .career-tag-open { background: var(--brand-100); color: var(--brand-700); }
  .career-card h3 { font-size: 1.25rem; color: var(--accent-deep); }
  .career-meta { color: var(--brand-600); font-weight: 600; font-size: 0.92rem; margin-top: -0.2rem; }
  .career-card p { color: var(--ink-500); flex: 1; }
  .career-card .btn { margin-top: 0.5rem; }

  @media (max-width: 640px) {
    .careers-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  function initMapConsent() {
    const box = document.getElementById("map-consent");
    const btn = document.getElementById("map-consent-btn");
    if (!box || !btn) return;
    btn.addEventListener("click", () => {
      const src = box.getAttribute("data-maps-src");
      if (!src) return;
      const iframe = document.createElement("iframe");
      iframe.title = "Standort Degoumois Dental AG auf der Karte";
      iframe.src = src;
      iframe.loading = "lazy";
      iframe.referrerPolicy = "no-referrer-when-downgrade";
      iframe.width = "100%";
      iframe.height = "100%";
      box.replaceWith(iframe);
    });
  }
  initMapConsent();
  document.addEventListener("astro:after-swap", initMapConsent);
</script>
