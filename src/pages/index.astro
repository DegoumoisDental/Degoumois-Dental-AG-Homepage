---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import PartnerStrip from "../components/PartnerStrip.astro";
import NewsCard from "../components/NewsCard.astro";
import Icon from "../components/Icon.astro";
import { services } from "../data/services";
import { site } from "../site";
import { getNews } from "../lib/news";

const latestNews = (await getNews()).slice(0, 3);

const stats = [
  { value: "50+", label: "Jahre Erfahrung seit 1972" },
  { value: "10+", label: "Implantatsysteme im Einsatz" },
  { value: "100%", label: "Made in Solothurn" },
];
---

<BaseLayout
  hero
  metaTitle="Dentallabor Solothurn | Degoumois Dental AG"
  description="Degoumois Dental AG – Ihr Dentallabor in Solothurn seit 1972. CAD/CAM, Implantatprothetik, Vollkeramik, digitale Zahntechnik und persönlicher Service."
>
  <Hero />

  <!-- Intro -->
  <section class="section" id="intro">
    <div class="container intro-grid">
      <div data-reveal>
        <p class="eyebrow">Ihr Dentallabor in Solothurn</p>
        <h2>Präzision, die man sieht – Partnerschaft, die man spürt.</h2>
      </div>
      <div data-reveal data-delay="1">
        <p class="lead">
          Die Degoumois Dental AG ist ein modernes Dentallabor im Herzen von Solothurn.
          Seit 1972 fertigen wir individuellen Zahnersatz mit hohen Ansprüchen an Präzision,
          Funktion und natürliche Ästhetik.
        </p>
        <p>
          Unser Leistungsspektrum verbindet traditionelle Zahntechnik mit digitalen
          Technologien wie CAD/CAM, 3D-Druck, Intraoral-Scanning und digitaler
          Implantatplanung.
        </p>
        <p>
          Für Zahnarztpraxen bedeutet das: kompetente Ansprechpartner, kurze
          Kommunikationswege, hohe Flexibilität und einen Partner, der auch komplexe
          zahntechnische Fälle persönlich begleitet.
        </p>
        <p>
          Unser eigener Kurierdienst sorgt zusätzlich für eine zuverlässige und
          termingerechte Zusammenarbeit in der Region Solothurn und Bern.
        </p>
        <a href="/ueber-uns" class="btn btn-ghost" style="margin-top:1.5rem;">
          Mehr über uns <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>

  <!-- Leistungen -->
  <section class="section services-section">
    <div class="container">
      <div class="svc-head" data-reveal>
        <p class="svc-eyebrow"><span class="svc-dash"></span>Unsere Leistungen</p>
        <h2 class="svc-title">
          Alles für hochwertigen Zahnersatz,<br />
          <span class="svc-title-muted">aus einer präzisen Hand.</span>
        </h2>
        <p class="svc-sub">
          Von der digitalen Planung bis zur fertigen Restauration: Bei Degoumois Dental
          verbinden wir zahntechnische Erfahrung mit moderner Technologie, präziser Fertigung
          und persönlicher Beratung.
        </p>
      </div>
      <div class="svc-grid">
        {services.filter((s) => s.homepage !== false).map((s, i) => (
          <a
            href={`/leistungen#${s.slug}`}
            class="svc-card"
            data-reveal
            data-delay={(i % 3) + 1}
          >
            {s.image && <img class="svc-card-bg" src={s.image} alt="" loading="lazy" decoding="async" />}
            <span class="svc-card-overlay" aria-hidden="true"></span>
            <div class="svc-card-top">
              <span class="svc-chip"><Icon name={s.icon} /></span>
              <span class="svc-num">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <div class="svc-card-body">
              <h3 class="svc-card-title">{s.title}</h3>
              <p class="svc-card-text">{s.short}</p>
              <span class="svc-more">Mehr erfahren <Icon name="arrow" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <PartnerStrip />

  <!-- Stimmungsbild / Impact – durchgehendes, seitenbreites Bild -->
  <section class="photo-band">
    <img
      class="photo-band-img"
      src="/img/labor/slider.jpg"
      alt="Einblick ins Dentallabor der Degoumois Dental AG in Solothurn"
      loading="lazy"
      decoding="async"
    />
  </section>

  <!-- Werte / Stats -->
  <section class="section values">
    <div class="container values-grid">
      <div class="values-text" data-reveal>
        <p class="eyebrow">Unsere Werte</p>
        <h2>Vertrauen in unsere Kompetenz ist die Basis für erstklassige Qualität.</h2>
        <p>
          Hochwertiger Zahnersatz entsteht für uns aus dem Zusammenspiel von Erfahrung,
          Präzision, geeigneten Materialien und einer engen Zusammenarbeit zwischen
          Zahnarztpraxis und Dentallabor.
        </p>
        <p>
          Alle von uns eingesetzten Werkstoffe erfüllen hohe zahnmedizinische Standards.
          Jeder Auftrag wird individuell geplant und von unserem erfahrenen Team mit grosser
          Sorgfalt umgesetzt. So entstehen zahntechnische Einzelanfertigungen, bei denen
          Funktion, Passung und Ästhetik gleichermassen im Mittelpunkt stehen.
        </p>
        <a href="/kontakt" class="btn btn-primary" style="margin-top:1.5rem;">
          Zusammenarbeit starten <Icon name="arrow" />
        </a>
      </div>
      <ul class="stats">
        {stats.map((s, i) => (
          <li data-reveal data-delay={i + 1}>
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- News-Teaser -->
  <section class="section" style="background:var(--surface-2);border-top:1px solid var(--line);">
    <div class="container">
      <div class="section-head-row" data-reveal>
        <div>
          <p class="eyebrow">Aktuelles</p>
          <h2>News aus dem Labor</h2>
        </div>
        <a href="/news" class="btn btn-ghost">Alle News <Icon name="arrow" /></a>
      </div>
      <div class="grid news-grid">
        {latestNews.map((post, i) => (
          <div data-reveal data-delay={(i % 3) + 1}><NewsCard post={post} /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="container cta-inner" data-reveal>
      <h2>Sie möchten einen Termin vereinbaren?</h2>
      <p class="cta-sub">Lernen Sie uns kennen. Wir freuen uns über Ihren Anruf.</p>
      <a href={`tel:${site.phone.replace(/\s/g, "")}`} class="cta-phone">{site.phone}</a>
      <p class="cta-mail">Oder schreiben Sie uns einfach eine <a href={`mailto:${site.email}`}>E-Mail</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .intro-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .section-head { display: flex; flex-direction: column; align-items: center; gap: 0.8rem; text-align: center; margin-bottom: 3.5rem; }
  .section-head h2 { max-width: 18ch; }
  .section-head-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; margin-bottom: 3rem; flex-wrap: wrap; }

  /* ── Leistungen (Service-Cards) ─────────────────────── */
  .services-section { background: #fff; }
  .svc-head { display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: 3.5rem; }
  .svc-eyebrow {
    display: inline-block;
    font-family: var(--font-accent); font-style: italic; font-weight: 500; font-size: 1.2rem;
    letter-spacing: 0; text-transform: none; color: var(--brand-600);
    margin-bottom: 1.1rem;
  }
  .svc-dash { display: none; }
  .svc-title { font-size: clamp(1.9rem, 3.4vw, 2.9rem); line-height: 1.12; letter-spacing: -0.02em; }
  .svc-title-muted { color: var(--ink-400); }
  .svc-sub { margin-top: 1.1rem; max-width: 46ch; color: var(--ink-500); font-size: 1.02rem; }

  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }

  .svc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 340px;
    padding: 1.6rem;
    border-radius: 22px;
    overflow: hidden;
    isolation: isolate;
    background: var(--brand-900);
    color: #fff;
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }
  .svc-card:hover { transform: translateY(-6px); box-shadow: 0 24px 50px rgba(12, 58, 85, 0.22); }

  /* Hintergrundbild + dunkles Overlay für Lesbarkeit */
  .svc-card-bg {
    position: absolute; inset: 0; z-index: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .svc-card:hover .svc-card-bg { transform: scale(1.05); }
  .svc-card-overlay {
    position: absolute; inset: 0; z-index: 0;
    background: linear-gradient(180deg, rgba(8,41,61,0.45) 0%, rgba(8,41,61,0.55) 45%, rgba(8,41,61,0.86) 100%);
  }

  .svc-card-top { position: relative; z-index: 1; display: flex; align-items: flex-start; justify-content: space-between; }
  .svc-chip {
    width: 52px; height: 52px; border-radius: 14px;
    display: grid; place-items: center; font-size: 26px;
    background: rgba(255,255,255,0.95); color: var(--brand-700);
    box-shadow: 0 6px 16px rgba(8, 41, 61, 0.25);
  }
  .svc-num { font-family: var(--font-display); font-weight: 700; font-size: 0.95rem; color: rgba(255,255,255,0.85); letter-spacing: 0.02em; }

  .svc-card-body { position: relative; z-index: 1; margin-top: auto; padding-top: 2.5rem; }
  .svc-card-title { font-size: 1.3rem; margin-bottom: 0.5rem; letter-spacing: -0.01em; color: #fff; }
  .svc-card-text { color: rgba(255,255,255,0.9); font-size: 0.95rem; }
  .svc-more {
    display: inline-flex; align-items: center; gap: 0.4em; margin-top: 1.1rem;
    font-family: var(--font-display); font-weight: 600; font-size: 0.9rem; color: #fff;
  }
  .svc-more svg { width: 1.05em; height: 1.05em; transition: transform 0.25s var(--ease); }
  .svc-card:hover .svc-more svg { transform: translateX(4px); }

  .values-grid { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .values-text h2 { font-size: clamp(1.6rem, 2.6vw, 2.3rem); margin-block: 1rem; }
  .stats { display: flex; flex-direction: column; gap: 1rem; }
  .stats li {
    background: linear-gradient(135deg, var(--brand-600), var(--brand-900));
    color: #fff; border-radius: var(--radius-lg); padding: 1.75rem 2rem;
    display: flex; flex-direction: column;
  }
  .stat-value { font-family: var(--font-display); font-weight: 800; font-size: 2.6rem; line-height: 1; }
  .stat-label { color: rgba(255,255,255,0.8); margin-top: 0.4rem; }

  .news-grid { grid-template-columns: repeat(3, 1fr); }

  /* Photo Band */
  .photo-band { overflow: hidden; line-height: 0; }
  .photo-band-img {
    display: block;
    width: 100%;
    height: clamp(280px, 40vw, 580px);
    object-fit: cover;
    object-position: center;
  }

  .cta { background: #fff; padding-block: clamp(4rem, 8vw, 6.5rem); }
  .cta-inner { text-align: center; max-width: 700px; margin-inline: auto; }
  .cta-inner h2 { color: var(--accent-deep); }
  .cta-sub { color: var(--ink-500); margin-top: 1rem; font-size: 1.1rem; }
  .cta-phone {
    display: inline-block; margin-top: 1.5rem;
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(2rem, 5vw, 3.1rem); letter-spacing: 0.01em;
    color: var(--accent-deep); transition: color 0.2s var(--ease);
  }
  .cta-phone:hover { color: var(--brand-600); }
  .cta-mail { margin-top: 1.5rem; color: var(--ink-500); font-size: 1.05rem; }
  .cta-mail a { color: var(--brand-600); text-decoration: underline; text-underline-offset: 3px; }
  .cta-mail a:hover { color: var(--brand-700); }

  @media (max-width: 900px) {
    .intro-grid, .values-grid { grid-template-columns: 1fr; }
    .svc-grid { grid-template-columns: repeat(2, 1fr); }
    .news-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) { .svc-grid { grid-template-columns: 1fr; } }
</style>
